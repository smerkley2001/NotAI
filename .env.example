# Server keys must be entered in Vercel settings; never commit actual secrets.
SUPABASE_URL=https://YOUR-ISOLATED-TEST-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Ordering stays closed until catalog, shipping, tax, proof, and webhook checks pass.
NOTAI_CHECKOUT_ENABLED=false
# Shipping is now controlled by the owner dashboard in shop_settings.
# Owner membership is managed by a privileged operator in public.shop_owners.
# Preview writes additionally require a database different from the production project.
NOTAI_PREVIEW_WRITES=false
NOTAI_CHECKOUT_RETURN_ORIGIN=
# Optional wording help: model must support Responses structured outputs.
OPENAI_API_KEY=
NOTAI_WRITING_MODEL=
NOTAI_AI_WRITING_ENABLED=false

# Optional override; default is the existing precision-editing image model.
NOTAI_IMAGE_MODEL=gpt-image-2.5-sunburst
